{
  "name": "rsc-sentinel",
  "version": "0.2.0",
  "description": "Live vulnerability scanning and production-hardened Server Action guards for React Server Components & Next.js App Router projects.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./guard": {
      "types": "./dist/guard.d.ts",
      "import": "./dist/guard.js"
    },
    "./scanner": {
      "types": "./dist/scanner.d.ts",
      "import": "./dist/scanner.js"
    }
  },
  "bin": {
    "rsc-sentinel": "bin/rsc-sentinel.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-test',{recursive:true,force:true});\"",
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && npm run build:test && node scripts/run-tests.mjs",
    "test:unit": "npm run build && npm run build:test && node scripts/run-tests.mjs unit",
    "test:security": "npm run build && npm run build:test && node scripts/run-tests.mjs security",
    "test:integration": "npm run build && npm run build:test && node scripts/run-tests.mjs integration",
    "check": "node ./bin/rsc-sentinel.js check",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test"
  },
  "keywords": [
    "nextjs",
    "next",
    "react",
    "react-server-components",
    "rsc",
    "server-actions",
    "security",
    "vulnerability-scanner",
    "app-router",
    "cve-2026-23869"
  ],
  "author": "Abdullah Jan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdullahJan-007/rsc-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/AbdullahJan-007/rsc-sentinel/issues"
  },
  "homepage": "https://github.com/AbdullahJan-007/rsc-sentinel#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "next": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
